# Copie este archivo como .env y cambie los valores. NUNCA suba el .env al repositorio.
# En AWS el mismo .env debe estar en las 3 máquinas.

# Secretos compartidos (use valores largos y aleatorios, por ejemplo: openssl rand -hex 32)
DFS_JWT_SECRET=cambiar-jwt
DFS_BLOCK_SECRET=cambiar-block
DFS_INTERNAL_TOKEN=cambiar-internal
# Llave de cifrado en reposo de los DataNodes
DFS_NODE_KEY=cambiar-node-key

# Usuarios que se crean al arrancar (usuario:contraseña separados por comas)
DFS_USERS=miguel:miguel123,abel:abel123

# Parámetros del sistema
DFS_REPLICATION=3
DFS_WRITE_QUORUM=2
DFS_GC_GRACE=600

# ---- Solo para AWS (deploy/aws): IPs privadas de las 3 EC2 ----
IP1=10.0.1.10
IP2=10.0.1.11
IP3=10.0.1.12
